{
  "name": "telegram-bulk-downloader",
  "version": "1.1.2",
  "description": "CLI tool for downloading Telegram media with date filtering, reply-thread support, and improved file naming",
  "main": "build/index.js",
  "bin": "build/bin.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node build/bin.js"
  },
  "license": "MIT",
  "keywords": [
    "telegram",
    "downloader",
    "cli",
    "archive",
    "gramjs"
  ],
  "dependencies": {
    "@inquirer/checkbox": "^1.3.3",
    "byteroo": "^1.4.2",
    "cli-progress": "^3.12.0",
    "commander": "^11.0.0",
    "inquirer": "^8.2.5",
    "mime-types": "^2.1.35",
    "telegram": "^2.17.10"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.0",
    "@types/inquirer": "^9.0.3",
    "@types/mime-types": "^2.1.1",
    "@types/node": "^20.3.1",
    "typescript": "^5.6.3"
  }
}
